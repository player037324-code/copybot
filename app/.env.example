# ===== KEYS (fill these in ON THE SERVER only, never paste them anywhere else) =====
HELIUS_API_KEY=
JUP_API_KEY=
# Leave blank. Run `npm run wallet` and it fills this in for you.
PRIVATE_KEY=

# ===== WHO TO COPY =====
TARGET_WALLET=GijFWw4oNyh9ko3FaZforNsi3jk6wDovARpkKahPD4o5

# ===== MODE =====
# true = fake trades with real prices (no SOL spent). Flip to false to go live.
PAPER=true

# ===== BUYING =====
# SOL spent per copied buy
BUY_PCT=40
# Ignore target buys smaller than this (filters dust/test buys)
MIN_TARGET_BUY_SOL=4
# Max coins held at once
MAX_POSITIONS=0
# Buy again if target adds to a coin we already hold
COPY_REBUYS=false
# Market cap filter in USD at time of our buy (0 = off)
MIN_MCAP_USD=0
MAX_MCAP_USD=0

# ===== SELLING =====
# Mirror the target's sells (if they sell 50% of their bag, we sell 50% of ours)
MIRROR_SELLS=true
# Our own exits on top of mirroring (0 = off). 100 = sell all at 2x.
TAKE_PROFIT_PCT=0
STOP_LOSS_PCT=0
# Force sell after this many minutes no matter what (0 = off)
MAX_HOLD_MIN=0
# How often to check prices for TP/SL (ms)
PRICE_CHECK_MS=8000

# ===== EXECUTION =====
# 1500 = 15% slippage. Trenches need high slippage.
SLIPPAGE_BPS=2000
# Priority fee cap in lamports (1,000,000 = 0.001 SOL)
PRIORITY_FEE_LAMPORTS=1000000
